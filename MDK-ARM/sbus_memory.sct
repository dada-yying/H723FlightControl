; Explicit DMA buffer placement. Keil and command-line build use this same file.
LR_IROM1 0x08000000 0x00100000 {
  ER_IROM1 0x08000000 0x00100000 {
    *.o (RESET, +First)
    *(InRoot$$Sections)
    .ANY (+RO)
    .ANY (+XO)
  }
  RW_IRAM1 0x20000000 0x00020000 {
    .ANY (+RW +ZI)
  }
  RW_IRAM2 0x24000000 0x00050000 {
    *(.sbus_dma)
    *(.blackbox_dma)
    .ANY (+RW +ZI)
  }
}
